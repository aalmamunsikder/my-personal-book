{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Single owner profile record for the private diary.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Owner display name",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "userId",
        "displayName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Entry": {
      "title": "Entry",
      "description": "A private diary entry, poem, quote, fragment, or prose piece.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Optional entry title (empty string if untitled)",
          "minLength": 0,
          "maxLength": 300
        },
        "subtitle": {
          "type": "string",
          "description": "Optional poem or prose subtitle",
          "minLength": 0,
          "maxLength": 300
        },
        "content": {
          "type": "string",
          "description": "Original UTF-8 writing preserving all line breaks and stanzas",
          "minLength": 0,
          "maxLength": 200000
        },
        "type": {
          "type": "string",
          "description": "Category of writing",
          "enum": [
            "diary",
            "poem",
            "quote",
            "fragment",
            "prose"
          ]
        },
        "status": {
          "type": "string",
          "description": "Entry lifecycle status",
          "enum": [
            "draft",
            "complete",
            "archived"
          ]
        },
        "entryDate": {
          "type": "string",
          "description": "Diary date in YYYY-MM-DD format supporting backdating",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "mood": {
          "type": "string",
          "description": "Optional mood annotation",
          "minLength": 0,
          "maxLength": 40
        },
        "language": {
          "type": "string",
          "description": "Detected or chosen language script",
          "enum": [
            "bn",
            "en",
            "mixed",
            "other"
          ]
        },
        "isFavorite": {
          "type": "boolean",
          "description": "Whether the entry is marked as favorite"
        },
        "attribution": {
          "type": "string",
          "description": "Optional quote source or author attribution",
          "minLength": 0,
          "maxLength": 240
        },
        "fontPreference": {
          "type": "string",
          "description": "Preferred reading/writing typography",
          "enum": [
            "auto",
            "bangla",
            "serif",
            "sans"
          ]
        },
        "pageVariation": {
          "type": "string",
          "description": "Selected manuscript paper style variation",
          "enum": [
            "vintage-parchment",
            "ruled-notebook",
            "poetry-scroll",
            "epistolary-letter",
            "dot-commonplace",
            "nocturnal-vellum",
            "botanical-herbarium",
            "royal-illuminated",
            "deckle-handmade",
            "ledger-chronicle"
          ]
        },
        "wordCount": {
          "type": "number",
          "description": "Cached word count"
        },
        "collectionId": {
          "type": "string",
          "description": "Optional collection ID (empty string if none)",
          "minLength": 0,
          "maxLength": 128
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 10 normalized tag names",
          "maxLength": 10
        },
        "isLocked": {
          "type": "boolean",
          "description": "Whether this entry is protected by an owner passphrase"
        },
        "lockPasswordHash": {
          "type": "string",
          "description": "Salted PBKDF2-SHA256 digest of the passphrase. The plaintext password is never stored or transmitted.",
          "minLength": 0,
          "maxLength": 128
        },
        "lockSalt": {
          "type": "string",
          "description": "Hex-encoded random salt for the passphrase digest",
          "minLength": 0,
          "maxLength": 64
        },
        "lockHint": {
          "type": "string",
          "description": "Optional passphrase hint shown on the locked page plate",
          "minLength": 0,
          "maxLength": 160
        },
        "isTrashed": {
          "type": "boolean",
          "description": "Soft-deletion flag for Trash"
        },
        "deletedAtIso": {
          "type": "string",
          "description": "ISO timestamp when moved to trash, or empty string",
          "minLength": 0,
          "maxLength": 40
        },
        "version": {
          "type": "integer",
          "description": "Optimistic concurrency counter. Must increment by exactly 1 on every update.",
          "minimum": 1
        },
        "pageTemplateId": {
          "type": "string",
          "description": "Per-entry page template override (empty string means inherit)",
          "minLength": 0,
          "maxLength": 64
        },
        "appearanceOverrideJson": {
          "type": "string",
          "description": "Serialized per-entry appearance override (empty string means inherit)",
          "minLength": 0,
          "maxLength": 4000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "userId",
        "title",
        "subtitle",
        "content",
        "type",
        "status",
        "entryDate",
        "mood",
        "language",
        "isFavorite",
        "attribution",
        "fontPreference",
        "pageVariation",
        "wordCount",
        "collectionId",
        "tags",
        "isLocked",
        "lockPasswordHash",
        "lockSalt",
        "lockHint",
        "isTrashed",
        "deletedAtIso",
        "version",
        "pageTemplateId",
        "appearanceOverrideJson",
        "createdAt",
        "updatedAt"
      ]
    },
    "Collection": {
      "title": "Collection",
      "description": "Thematic notebook grouping diary entries, poems, quotes, or fragments.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Collection title in Bangla or English",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Optional notebook description",
          "minLength": 0,
          "maxLength": 500
        },
        "accent": {
          "type": "string",
          "description": "Muted accent token",
          "minLength": 0,
          "maxLength": 40
        },
        "sortOrder": {
          "type": "number",
          "description": "Display sort order"
        },
        "appearanceConfigJson": {
          "type": "string",
          "description": "Serialized collection-level appearance override",
          "minLength": 0,
          "maxLength": 4000
        },
        "version": {
          "type": "integer",
          "description": "Optimistic concurrency counter",
          "minimum": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "userId",
        "name",
        "description",
        "accent",
        "sortOrder",
        "appearanceConfigJson",
        "version",
        "createdAt",
        "updatedAt"
      ]
    },
    "Tag": {
      "title": "Tag",
      "description": "Owner tag record.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display tag name",
          "minLength": 1,
          "maxLength": 60
        },
        "normalizedName": {
          "type": "string",
          "description": "Lowercase normalized tag name",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": [
        "userId",
        "name",
        "normalizedName",
        "createdAt"
      ]
    },
    "AiUsage": {
      "title": "AiUsage",
      "description": "Server-side AI request metering, keyed by owner UID. Backs the daily budget enforced in /api/ai-assist.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "day": {
          "type": "string",
          "description": "UTC day the counter applies to",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "count": {
          "type": "integer",
          "description": "Requests consumed that day",
          "minimum": 0
        }
      },
      "required": [
        "userId",
        "day",
        "count"
      ]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Owner appearance, writing, and backup preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "readingWidth": {
          "type": "string",
          "enum": [
            "standard",
            "wide"
          ]
        },
        "density": {
          "type": "string",
          "enum": [
            "comfortable",
            "compact"
          ]
        },
        "defaultEntryType": {
          "type": "string",
          "enum": [
            "diary",
            "poem",
            "quote",
            "fragment",
            "prose"
          ]
        },
        "defaultFont": {
          "type": "string",
          "enum": [
            "auto",
            "bangla",
            "serif",
            "sans"
          ]
        },
        "showWordCount": {
          "type": "boolean"
        },
        "defaultMood": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "autosaveEnabled": {
          "type": "boolean"
        },
        "lastBackupAt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "theme",
        "readingWidth",
        "density",
        "defaultEntryType",
        "defaultFont",
        "showWordCount",
        "defaultMood",
        "autosaveEnabled",
        "lastBackupAt",
        "updatedAt"
      ]
    },
    "AiSettings": {
      "title": "AiSettings",
      "description": "Owner AI consent and enable state, mirrored to the server so /api/ai-assist can enforce it.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether AI features are switched on"
        },
        "hasConsented": {
          "type": "boolean",
          "description": "Explicit first-use consent recorded"
        },
        "consentVersion": {
          "type": "string",
          "description": "Version of the privacy terms accepted",
          "minLength": 1,
          "maxLength": 40
        },
        "consentAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "When consent was granted"
        },
        "defaultContextScope": {
          "type": "string",
          "description": "Minimum-context default for a request",
          "enum": [
            "selection",
            "current_entry",
            "selected_entries",
            "collection",
            "archive"
          ]
        },
        "dailyLimit": {
          "type": "integer",
          "description": "Requests allowed per UTC day; the server clamps it to 100",
          "minimum": 1,
          "maximum": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "userId",
        "enabled",
        "hasConsented",
        "consentVersion",
        "consentAt",
        "defaultContextScope",
        "dailyLimit",
        "createdAt",
        "updatedAt"
      ]
    },
    "AiUsageEvent": {
      "title": "AiUsageEvent",
      "description": "Append-only AI metering event. Carries the shape of a request and never its words: no prompt, no completion, no entry content.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requestId": {
          "type": "string",
          "description": "Opaque request id, also used as the document id",
          "minLength": 1,
          "maxLength": 64
        },
        "task": {
          "type": "string",
          "description": "Allowlisted task name",
          "enum": [
            "suggest_titles",
            "proofread",
            "refine",
            "explain_poem",
            "rhyme_helper",
            "translate",
            "summarize",
            "suggest_metadata",
            "writing_feedback",
            "continue_thought",
            "archive_answer",
            "custom_prompt"
          ]
        },
        "provider": {
          "type": "string",
          "description": "Provider label",
          "minLength": 1,
          "maxLength": 60
        },
        "model": {
          "type": "string",
          "description": "Server-configured model id",
          "minLength": 1,
          "maxLength": 80
        },
        "promptVersion": {
          "type": "string",
          "description": "Versioned prompt template used",
          "minLength": 1,
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "description": "Outcome of the request",
          "enum": [
            "complete",
            "error"
          ]
        },
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Prompt tokens reported by the provider",
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Completion tokens reported by the provider",
          "minimum": 0
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Server-side handling time",
          "minimum": 0
        }
      },
      "required": [
        "userId",
        "requestId",
        "task",
        "provider",
        "model",
        "promptVersion",
        "status"
      ]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": {
        "$ref": "#/entities/Profile"
      },
      "description": "Owner profile keyed by Firebase Auth UID."
    },
    "/entries/{entryId}": {
      "schema": {
        "$ref": "#/entities/Entry"
      },
      "description": "Private owner diary entries, poems, quotes, fragments, and prose."
    },
    "/collections/{collectionId}": {
      "schema": {
        "$ref": "#/entities/Collection"
      },
      "description": "Thematic collections owned by the user."
    },
    "/tags/{tagId}": {
      "schema": {
        "$ref": "#/entities/Tag"
      },
      "description": "Tags owned by the user."
    },
    "/settings/{userId}": {
      "schema": {
        "$ref": "#/entities/UserSettings"
      },
      "description": "Owner settings keyed by Firebase Auth UID."
    },
    "/aiUsage/{userId}": {
      "schema": {
        "$ref": "#/entities/AiUsage"
      },
      "description": "Server-side AI metering keyed by Firebase Auth UID."
    },
    "/aiSettings/{userId}": {
      "schema": {
        "$ref": "#/entities/AiSettings"
      },
      "description": "Owner AI consent and enable state keyed by Firebase Auth UID."
    },
    "/aiUsageEvents/{requestId}": {
      "schema": {
        "$ref": "#/entities/AiUsageEvent"
      },
      "description": "Append-only AI usage metadata. Owner-readable, never mutated."
    }
  }
}
