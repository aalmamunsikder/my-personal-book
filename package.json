    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "jose": "^6.2.14",
    "jszip": "^3.10.2",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
